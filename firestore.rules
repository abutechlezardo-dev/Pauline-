rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global default deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidMood(mood) {
      return mood is string && mood in ['SMILE', 'HAPPY', 'WINK', 'CALM'];
    }

    function isValidBackdrop(backdrop) {
      return backdrop is string && backdrop in ['CORAL', 'SAGE', 'LAVENDER', 'HONEY', 'SKY'];
    }

    function isValidUserPrefs(data, userId) {
      return data.userId is string &&
             data.userId == userId &&
             isValidMood(data.mood) &&
             isValidBackdrop(data.backdrop) &&
             data.createdAt is timestamp &&
             data.createdAt <= request.time &&
             data.updatedAt is timestamp &&
             data.updatedAt <= request.time;
    }

    function isValidChatMessage(data, userId) {
      return data.userId is string &&
             data.userId == userId &&
             data.sender is string &&
             data.sender in ['user', 'pauline'] &&
             data.text is string &&
             data.text.size() >= 1 &&
             data.text.size() <= 4000 &&
             (!('moodTag' in data) || isValidMood(data.moodTag)) &&
             data.createdAt is timestamp &&
             data.createdAt <= request.time &&
             data.updatedAt is timestamp &&
             data.updatedAt <= request.time;
    }

    function isValidMemoryItem(data, userId) {
      return data.userId is string &&
             data.userId == userId &&
             data.title is string &&
             data.title.size() >= 1 &&
             data.title.size() <= 120 &&
             data.detail is string &&
             data.detail.size() >= 1 &&
             data.detail.size() <= 1000 &&
             data.source is string &&
             data.source in ['auto', 'manual'] &&
             data.createdAt is timestamp &&
             data.createdAt <= request.time &&
             data.updatedAt is timestamp &&
             data.updatedAt <= request.time;
    }

    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if isOwner(userId);

      allow create: if isOwner(userId) &&
                       isValidId(userId) &&
                       incoming().keys().hasAll(['userId', 'mood', 'backdrop', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['userId', 'mood', 'backdrop', 'createdAt', 'updatedAt']) &&
                       isValidUserPrefs(incoming(), userId);

      allow update: if isOwner(userId) &&
                       isValidId(userId) &&
                       isValidUserPrefs(incoming(), userId) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['mood', 'backdrop', 'updatedAt']);

      allow delete: if isOwner(userId) && isValidId(userId);

      match /messages/{messageId} {
        allow get: if isOwner(userId) && isValidId(messageId);
        allow list: if isOwner(userId);

        allow create: if isOwner(userId) &&
                         isValidId(messageId) &&
                         incoming().keys().hasAll(['userId', 'sender', 'text', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['userId', 'sender', 'text', 'moodTag', 'createdAt', 'updatedAt']) &&
                         isValidChatMessage(incoming(), userId);

        allow update: if isOwner(userId) &&
                         isValidId(messageId) &&
                         isValidChatMessage(incoming(), userId) &&
                         incoming().userId == existing().userId &&
                         incoming().sender == existing().sender &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['text', 'moodTag', 'updatedAt']);

        allow delete: if isOwner(userId) && isValidId(messageId);
      }

      match /memories/{memoryId} {
        allow get: if isOwner(userId) && isValidId(memoryId);
        allow list: if isOwner(userId);

        allow create: if isOwner(userId) &&
                         isValidId(memoryId) &&
                         incoming().keys().hasAll(['userId', 'title', 'detail', 'source', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['userId', 'title', 'detail', 'source', 'createdAt', 'updatedAt']) &&
                         isValidMemoryItem(incoming(), userId);

        allow update: if isOwner(userId) &&
                         isValidId(memoryId) &&
                         isValidMemoryItem(incoming(), userId) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['title', 'detail', 'source', 'updatedAt']);

        allow delete: if isOwner(userId) && isValidId(memoryId);
      }
    }
  }
}
